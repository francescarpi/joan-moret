---
import portraitImg from '../assets/images/default-hex.svg';

interface Props {
  href?: string;
  class?: string;
  alt?: string;
  size?: number;
}

const { href, class: className, alt = '', size = 256 } = Astro.props;

// Original viewBox: 46.4 x 40.2 — mantiene proporción horizontal pointy-left/right
const aspect = 40.2 / 46.4;
const height = size * aspect;
const id = `hex-clip-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['hexagon-figure', className].filter(Boolean)}
  style={`--hex-width: ${size}px; --hex-height: ${height}px;`}
  data-href={href}
  role={href ? 'button' : undefined}
  tabindex={href ? 0 : undefined}
  aria-label={alt || href}
>
  <svg
    viewBox="0 0 46.4 40.2"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <clipPath id={id}>
        <polygon points="34.8,0 11.6,0 0,20.1 11.6,40.2 34.8,40.2 46.4,20.1" />
      </clipPath>
    </defs>
    <image
      href={portraitImg.src}
      x="0"
      y="0"
      width="46.4"
      height="40.2"
      preserveAspectRatio="xMidYMid slice"
      clip-path={`url(#${id})`}
      class="portrait"
    />
    <!-- Borde blanco de 2px que sigue exactamente la forma del hexágono -->
    <polygon
      points="34.8,0 11.6,0 0,20.1 11.6,40.2 34.8,40.2 46.4,20.1"
      fill="none"
      stroke="white"
      stroke-width="2"
      vector-effect="non-scaling-stroke"
      class="border"
    />
  </svg>
</div>

<style define:vars={{ hexWidth: `${size}px`, hexHeight: `${height}px` }}>
  .hexagon-figure {
    width: var(--hex-width);
    height: var(--hex-height);
    cursor: pointer;
    position: relative;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .hexagon-figure:hover,
  .hexagon-figure:focus-visible {
    outline: none;
    transform: scale(1.03);
  }

  .hexagon-figure svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Por defecto: imagen más clara (opacity 0.5 igual que .st0 del SVG original) */
  .hexagon-figure .portrait {
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  /* Hover / focus: color completo */
  .hexagon-figure:hover .portrait,
  .hexagon-figure:focus-visible .portrait {
    opacity: 1;
  }
</style>

<script>
  // TODO: acción de click pendiente de definir
  document.querySelectorAll<HTMLElement>('.hexagon-figure[data-href]').forEach((el) => {
    el.addEventListener('click', () => {
      const target = el.getAttribute('data-href');
      if (target) {
        // acción pendiente de definir — de momento navega al href
        window.location.href = target;
      }
    });
    el.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
    });
  });
</script>
