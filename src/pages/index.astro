---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProyectoCarrusel from '../components/ProyectoCarrusel.astro';
import ProyectoLightbox from '../components/ProyectoLightbox.astro';
import Footer from '../components/Footer.astro'
---

<BaseLayout>
  <div class="flex flex-col emdd:flex-row gap-4 m-4">
    <Hero />
  </div>
  <div class="m-4 mt-6 mb-15">
    <h2 class="text-center mb-2">PROJECTES</h2>
    <ProyectoCarrusel />
  </div>
  <Footer />
  <ProyectoLightbox />
</BaseLayout>
